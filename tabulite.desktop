[Desktop Entry]
Name=Tabulite
Comment=View and filter tabular data
Exec=tabulite %F
Icon=tabulite
Terminal=false
Type=Application
Categories=Office;Spreadsheet;
MimeType=text/csv;text/tab-separated-values;application/vnd.apache.parquet;application/json;application/x-ndjson;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.sqlite3;application/x-sqlite3;application/geopackage+sqlite3;
StartupNotify=true
